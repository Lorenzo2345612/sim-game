{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "checks",
    "findings"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "APPROVED",
        "CHANGES",
        "REJECTED"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typecheck",
        "lint",
        "test"
      ],
      "properties": {
        "typecheck": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "n/a"
          ]
        },
        "lint": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "n/a"
          ]
        },
        "test": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "n/a"
          ]
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "location",
          "problem",
          "fix"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "BLOCKER",
              "MINOR",
              "DOUBT"
            ]
          },
          "location": {
            "type": "string"
          },
          "problem": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
