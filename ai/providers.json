{
  "providers": {
    "glm": {
      "baseUrl": "https://open.bigmodel.cn/api/anthropic",
      "keyEnv": "GLM_API_KEY",
      "maxConcurrent": 2
    },
    "kimi": {
      "baseUrl": "https://api.kimi.com/coding",
      "keyEnv": "KIMI_API_KEY",
      "maxConcurrent": 2
    },
    "mimo": {
      "baseUrl": "https://token-plan-sgp.xiaomimimo.com/anthropic",
      "keyEnv": "MIMO_TOKEN_PLAN_KEY",
      "maxConcurrent": 3
    },
    "claude": {
      "oauth": true,
      "model": "claude-sonnet-5-5",
      "heavyModel": "claude-sonnet-5-5",
      "maxConcurrent": 9
    }
  },
  "roles": {
    "acceptance": {
      "provider": "claude",
      "model": "claude-sonnet-5-5",
      "heavyModel": "claude-sonnet-5-5",
      "prompt": "ai/agents/acceptance.md",
      "timeoutMin": 20
    },
    "tester-pre": {
      "provider": "claude",
      "model": "claude-sonnet-5-5",
      "heavyModel": "claude-sonnet-5-5",
      "prompt": "ai/agents/tester-pre.md",
      "timeoutMin": 20
    },
    "coder": {
      "provider": "claude",
      "model": "claude-sonnet-5-5",
      "heavyModel": "claude-sonnet-5-5",
      "prompt": "ai/agents/coder.md",
      "timeoutMin": 25
    },
    "tester": {
      "provider": "claude",
      "model": "claude-sonnet-5-5",
      "heavyModel": "claude-sonnet-5-5",
      "prompt": "ai/agents/tester.md",
      "timeoutMin": 25
    },
    "reviewer": {
      "provider": "claude",
      "model": "claude-sonnet-5-5",
      "heavyModel": "claude-sonnet-5-5",
      "prompt": "ai/agents/reviewer.md",
      "timeoutMin": 20
    },
    "fixer": {
      "provider": "claude",
      "model": "claude-sonnet-5-5",
      "heavyModel": "claude-sonnet-5-5",
      "prompt": "ai/agents/coder.md",
      "timeoutMin": 25
    }
  },
  "fallback": {
    "provider": "mimo",
    "model": "mimo-v2.6-flash",
    "heavyModel": "mimo-v2.6-flash",
    "overflowRoles": [
      "coder",
      "acceptance",
      "tester-pre",
      "tester",
      "reviewer"
    ]
  }
}
