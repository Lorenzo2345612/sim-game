{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/ai/worker.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-planner-code-edits.sh"
          }
        ]
      }
    ]
  }
}
